{
  "name": "nestjs-wire-contracts",
  "version": "0.0.0",
  "description": "Typed, validated contracts for @nestjs/microservices message patterns (TCP, Redis, NATS, Kafka, RabbitMQ, MQTT). Early development placeholder.",
  "license": "Apache-2.0",
  "author": "elleVas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elleVas/nestjs-wire-contracts.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/elleVas/nestjs-wire-contracts",
  "keywords": [
    "nestjs",
    "microservices",
    "typescript",
    "zod",
    "contracts",
    "message-pattern"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
