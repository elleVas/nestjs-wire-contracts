{
  "name": "nestjs-wire-contracts-zod",
  "version": "0.0.0",
  "description": "Zod adapter for nestjs-wire-contracts-core: define contract schemas with Zod for runtime validation and type inference.",
  "license": "Apache-2.0",
  "author": "elleVas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elleVas/nestjs-wire-contracts.git",
    "directory": "packages/zod"
  },
  "homepage": "https://github.com/elleVas/nestjs-wire-contracts",
  "keywords": [
    "nestjs",
    "microservices",
    "typescript",
    "zod",
    "contracts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nestjs-wire-contracts-core": "workspace:*",
    "zod": "^4.4.3"
  }
}
