{
  "name": "nestjs-wire-contracts-core",
  "version": "0.0.0",
  "description": "Core contract types and builder for nestjs-wire-contracts, independent of any validation library.",
  "license": "Apache-2.0",
  "author": "elleVas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elleVas/nestjs-wire-contracts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/elleVas/nestjs-wire-contracts",
  "keywords": [
    "nestjs",
    "microservices",
    "typescript",
    "contracts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
